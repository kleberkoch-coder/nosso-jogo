rules_version = '2';
// Regras de segurança do site da pelada (vários grupos).
// Cole este conteúdo inteiro em: Firebase > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function realUser() { return signed() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function grp(gid) { return /databases/$(database)/documents/grupos/$(gid); }
    function isMember(gid) {
      return realUser() && exists(/databases/$(database)/documents/grupos/$(gid)/membros/$(request.auth.uid));
    }
    function isOwner(gid) { return realUser() && get(grp(gid)).data.owner == request.auth.uid; }
    function grpAtivo(gid) { return get(grp(gid)).data.get('ativo', true) == true; }
    // Caixa (chave Pix, mensalidade e diária) fica só em /privado/caixa (KAN-79). Desde 13/10/2026 nenhum grupo
    // tem mais esses valores no documento público (conferido no console), então eles não podem existir ali.
    function caixaOk() {
      return !('pix' in request.resource.data.get('cfg', {}))
        && !('mensal' in request.resource.data.get('cfg', {}))
        && !('diaria' in request.resource.data.get('cfg', {}));
    }
    function rod(gid, rid) { return /databases/$(database)/documents/grupos/$(gid)/rodadas/$(rid); }
    // Rodada aceitando confirmações: grupo ativo e lista aberta (ou jogo fixo ainda sem documento).
    function presencaAberta(gid, rid) {
      return signed() && grpAtivo(gid) && (
        (!exists(rod(gid, rid)) && rid.matches('f-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}') && dataProxima(rid))
        || (exists(rod(gid, rid))
          && get(rod(gid, rid)).data.get('locked', false) == false
          && get(rod(gid, rid)).data.get('cancelada', false) == false)
      );
    }
    // KAN-77: jogo fixo ainda sem documento só aceita presença de ontem até 15 dias à frente (nada de datas inventadas, como 2099).
    function dataDoFixo(rid) { return timestamp.date(int(rid.split('-')[1]), int(rid.split('-')[2]), int(rid.split('-')[3])); }
    function dataProxima(rid) {
      return dataDoFixo(rid) > request.time - duration.value(2, 'd') && dataDoFixo(rid) < request.time + duration.value(15, 'd');
    }
    // Identificador gerado pelo app: só letras, números, _ e - (KAN-76: impede injetar código pelo nome do documento).
    function idValido(id) { return id is string && id.matches('[A-Za-z0-9_-]{1,64}'); }
    function presencaValida() {
      return request.resource.data.keys().hasOnly(['s', 't', 'by', 'dev', 'nome', 'avulso', 'pos'])
        && request.resource.data.s in ['in', 'out']
        && request.resource.data.by == request.auth.uid
        && (!('nome' in request.resource.data) || (request.resource.data.nome is string && request.resource.data.nome.size() <= 40))
        && (!('pos' in request.resource.data) || (request.resource.data.pos is string && request.resource.data.pos.size() <= 4))
        && request.resource.data.get('t', 0) is int;
    }
    // KAN-78: a ordem da lista vem da hora da confirmação (t), enviada pelo celular. Pelo link ela não pode
    // ser do futuro nem de mais de 6 horas atrás (folga para quem confirmou sem sinal).
    function horaOk() {
      return request.resource.data.t <= request.time.toMillis() + 60000
        && request.resource.data.t >= request.time.toMillis() - 6 * 3600000;
    }
    // Na mudança pelo link: a hora só muda quando a resposta muda (e nunca volta para trás), e nome, avulso e posição não mudam.
    function mudancaPeloLinkOk() {
      return ((request.resource.data.s == resource.data.s && request.resource.data.get('t', null) == resource.data.get('t', null))
          || (request.resource.data.s != resource.data.s && horaOk() && request.resource.data.t >= resource.data.get('t', 0)))
        && request.resource.data.get('nome', null) == resource.data.get('nome', null)
        && request.resource.data.get('avulso', null) == resource.data.get('avulso', null)
        && request.resource.data.get('pos', null) == resource.data.get('pos', null);
    }

    // Limites contra abuso (KAN-89). Os números ficam em /sistema/limites: muda no console do Firebase e vale na hora.
    // Sem o documento, valem os padrões abaixo (os mesmos de src/dominio/limites.ts).
    function cfgLim() { return /databases/$(database)/documents/sistema/limites; }
    function lim(k, padrao) {
      return exists(cfgLim()) && get(cfgLim()).data.get(k, padrao) is int && get(cfgLim()).data.get(k, padrao) >= 0
        ? get(cfgLim()).data.get(k, padrao) : padrao;
    }
    function limAvulsos() { return lim('avulsosPorRodada', 30); }
    function limGrupos() { return lim('gruposPorConta', 20); }
    function pres(gid, rid, pid) { return /databases/$(database)/documents/grupos/$(gid)/rodadas/$(rid)/presencas/$(pid); }
    function contAv(gid, rid) { return /databases/$(database)/documents/grupos/$(gid)/rodadas/$(rid)/limites/avulsos; }
    function conta(uid) { return /databases/$(database)/documents/contas/$(uid); }
    // Avulso novo pelo link: a mesma gravação soma 1 no contador da rodada e deixa nele o identificador deste avulso.
    function avulsoContado(gid, rid, pid) {
      return existsAfter(contAv(gid, rid))
        && getAfter(contAv(gid, rid)).data.get('ult', '') == pid
        && getAfter(contAv(gid, rid)).data.get('n', 0) == (exists(contAv(gid, rid)) ? get(contAv(gid, rid)).data.get('n', 0) : 0) + 1;
    }
    // Grupo novo: a mesma gravação soma 1 no contador da conta e deixa nele o identificador do grupo.
    function grupoContado(gid) {
      return existsAfter(conta(request.auth.uid))
        && getAfter(conta(request.auth.uid)).data.get('ult', '') == gid
        && getAfter(conta(request.auth.uid)).data.get('ng', 0) == (exists(conta(request.auth.uid)) ? get(conta(request.auth.uid)).data.get('ng', 0) : 0) + 1;
    }
    // Administrador do portal (KAN-116): só as contas Google cujo identificador (uid) está nesta lista.
    // O portal fica num site separado (sem criação de conta); o identificador é incluído aqui à mão,
    // numa proposta de mudança aprovada pelo Kleber. Lista vazia = ninguém acessa.
    function adminPortal() {
      return realUser() && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid in /*ADMINS_PORTAL*/[];
    }
    function camposMudados() {
      return resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
    }
    // Contador de grupos (KAN-89): só sobe de 1 em 1, junto com a criação de um grupo da própria conta, até o limite.
    function contadorOk(uid) {
      return camposMudados().hasOnly(['ng', 'ult'])
        && idValido(request.resource.data.get('ult', ''))
        && request.resource.data.ng == (resource == null ? 0 : resource.data.get('ng', 0)) + 1
        && request.resource.data.ng <= limGrupos()
        && !exists(grp(request.resource.data.ult))
        && existsAfter(grp(request.resource.data.ult))
        && getAfter(grp(request.resource.data.ult)).data.owner == uid;
    }
    // Último acesso (KAN-116): a hora de agora (com folga de 10 minutos), o e-mail da própria conta e a data do primeiro registro.
    function acessoOk() {
      return camposMudados().hasOnly(['acesso', 'email', 'criada'])
        && request.resource.data.acesso is int
        && request.resource.data.acesso <= request.time.toMillis() + 60000
        && request.resource.data.acesso >= request.time.toMillis() - 600000
        && request.resource.data.get('email', request.auth.token.email) == request.auth.token.email
        && (resource == null || !('criada' in resource.data) || request.resource.data.criada == resource.data.criada)
        && (!('criada' in request.resource.data) || request.resource.data.criada is int);
    }
    function nomeOk(campo) {
      return !(campo in request.resource.data) || (request.resource.data[campo] is string && request.resource.data[campo].size() <= 40);
    }

    // Configuração dos limites: todos leem (o app avisa antes de chegar no limite); só o console do Firebase grava.
    match /sistema/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Ficha de cada conta: contador de grupos (KAN-89), último acesso (KAN-116) e plano (KAN-115).
    match /contas/{uid} {
      // Cada conta lê a própria ficha; o administrador do portal lê todas (KAN-116).
      allow read: if (realUser() && request.auth.uid == uid) || adminPortal();
      // A própria conta grava só o contador de grupos (KAN-89) ou o último acesso (KAN-116). Nunca o plano.
      allow create, update: if realUser() && request.auth.uid == uid && (contadorOk(uid) || acessoOk());
      // O plano (KAN-115) só é gravado pelo administrador do portal (e, no futuro, pelo servidor de pagamento).
      allow create, update: if adminPortal() && camposMudados().hasOnly(['plano', 'planoAte', 'obs'])
        && request.resource.data.get('plano', 'gratis') is string && request.resource.data.get('plano', 'gratis').size() <= 20
        && (!('planoAte' in request.resource.data) || request.resource.data.planoAte == null || request.resource.data.planoAte is int)
        && (!('obs' in request.resource.data) || (request.resource.data.obs is string && request.resource.data.obs.size() <= 200));
      allow delete: if false;
    }

    // Lista "Meus grupos" de cada conta: só a própria pessoa lê e grava.
    match /usuarios/{uid} {
      allow read, write: if realUser() && request.auth.uid == uid;
    }

    match /grupos/{gid} {
      // Nome e configurações do grupo aparecem nos links públicos (ler UM grupo).
      // Listar todos os grupos, só o administrador do portal (KAN-133).
      allow get: if true;
      allow list: if adminPortal();
      // Grupo novo conta no limite de grupos por conta (KAN-89); nome com até 40 letras.
      // TEMPORÁRIO (10/10/2026): o site no ar ainda é a v19, que não grava o contador de grupos (o Netlify pausou as publicações).
      // Enquanto isso, o contador é opcional. Voltar a exigir grupoContado(gid) quando a v23 ou mais nova estiver no ar.
      allow create: if realUser() && request.resource.data.owner == request.auth.uid && caixaOk()
        && nomeOk('name') && (grupoContado(gid) || true);
      // Dono e data de criação não mudam; só o organizador ativa ou inativa o grupo.
      allow update: if isMember(gid)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
        && (request.resource.data.get('ativo', true) == resource.data.get('ativo', true) || isOwner(gid))
        && caixaOk();
      allow delete: if isOwner(gid);

      // Administradores do grupo.
      match /membros/{uid} {
        allow read: if isMember(gid) || (signed() && request.auth.uid == uid) || adminPortal();
        allow create: if realUser() && request.auth.uid == uid && request.resource.data.uid == uid && (
          // quem criou o grupo vira organizador
          (request.resource.data.role == 'owner' && get(grp(gid)).data.owner == uid)
          // ou quem tem o link de convite válido vira administrador
          || (request.resource.data.role == 'admin'
              && exists(/databases/$(database)/documents/grupos/$(gid)/privado/convite)
              && request.resource.data.token == get(/databases/$(database)/documents/grupos/$(gid)/privado/convite).data.token)
        );
        // O próprio administrador grava só como entrou da última vez (Google ou e-mail e senha). Nada mais muda.
        allow update: if realUser() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['via'])
          && request.resource.data.via in ['google', 'senha'];
        allow delete: if isOwner(gid) || (realUser() && request.auth.uid == uid && get(grp(gid)).data.owner != uid);
      }

      // Notas, pares separados, contatos, link de convite e caixa (valores, Pix, tipo do jogador): só administradores.
      match /privado/{doc} {
        allow read, write: if isMember(gid);
      }

      match /jogadores/{id} {
        allow read: if true;
        allow create, update: if isMember(gid) && nomeOk('name');
        allow delete: if isMember(gid);
      }

      // Avulsos que já jogaram: o nome e a posição aparecem no link público
      // para quem volta não precisar se cadastrar de novo. Nota e contato ficam em /privado.
      match /avulsos/{id} {
        allow read: if true;
        allow create, update: if isMember(gid) && nomeOk('nome');
        allow delete: if isMember(gid);
      }

      match /rodadas/{rid} {
        allow read: if true;
        allow write: if isMember(gid);

        // Presença: qualquer pessoa com o link confirma (login anônimo automático).
        // 'dev' guarda o aparelho que respondeu primeiro e não pode ser trocado por outro aparelho.
        // 'by' é sempre quem gravou por último. Assim o administrador vê quando alguém
        // mudou a resposta de outra pessoa.
        match /presencas/{pid} {
          allow read: if true;
          // Pelo link, nome que não é de jogador cadastrado entra como avulso novo e conta no limite da rodada (KAN-89).
          allow create: if isMember(gid) || (
            idValido(pid) && presencaAberta(gid, rid) && presencaValida() && horaOk()
            && request.resource.data.get('dev', '') == request.auth.uid
            // TEMPORÁRIO (10/10/2026): o site no ar ainda é a v19, que não grava o contador de avulsos (Netlify pausado).
            // Enquanto isso, o contador é opcional. Voltar a exigir quando a v23 ou mais nova estiver no ar.
            && (exists(/databases/$(database)/documents/grupos/$(gid)/jogadores/$(pid)) || avulsoContado(gid, rid, pid) || true)
          );
          allow update: if isMember(gid) || (
            idValido(pid) && presencaAberta(gid, rid) && presencaValida() && mudancaPeloLinkOk()
            && ((('dev' in resource.data) && request.resource.data.get('dev', '') == resource.data.dev)
              || (!('dev' in resource.data) && request.resource.data.get('dev', '') == request.auth.uid))
          );
          allow delete: if isMember(gid);
        }

        // Avulsos novos pelo link nesta rodada (KAN-89): o contador só sobe de 1 em 1, junto com a presença
        // de um avulso que ainda não estava na lista, até o limite. Administradores podem zerar (apagar).
        match /limites/{doc} {
          allow read: if true;
          allow create, update: if signed() && doc == 'avulsos'
            && request.resource.data.keys().hasOnly(['n', 'ult'])
            && idValido(request.resource.data.get('ult', ''))
            && request.resource.data.n == (resource == null ? 0 : resource.data.get('n', 0)) + 1
            && request.resource.data.n <= limAvulsos()
            && !exists(pres(gid, rid, request.resource.data.ult))
            && existsAfter(pres(gid, rid, request.resource.data.ult));
          allow delete: if isMember(gid);
        }

        // Partidas da rodada (pelada-v18, KAN-86): placar e autor de cada ponto.
        // Leitura aberta como a da rodada (o jogador vê o placar pelo link); só administradores gravam.
        // Criar só se ainda não existe e apagar só se existe: assim, se dois aparelhos fazem a mesma coisa,
        // o segundo lote é recusado inteiro e o ranking não conta em dobro. Partida não é editada.
        match /partidas/{mid} {
          allow read: if true;
          allow create: if isMember(gid);
          allow update: if false;
          allow delete: if isMember(gid) && resource != null;
        }
      }

      // Totais prontos por mês (pelada-v18, KAN-87): ranking e caixa. Só administradores leem e gravam.
      match /resumos/{mes} {
        allow read: if isMember(gid);
        allow write: if isMember(gid)
          && mes.matches('[0-9]{4}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['mes', 'at', 'jog', 'jogos', 'cx'])
          && request.resource.data.mes == mes;
      }

      match /caixa/{id} {
        allow read, create, update: if isMember(gid);
        // Apagar só o que existe: um lançamento apagado duas vezes não desconta o resumo em dobro (pelada-v18).
        allow delete: if isMember(gid) && resource != null;
      }

      match /votacoes/{vid} {
        allow read: if true;
        allow write: if isMember(gid);

        // Um voto por aparelho, só enquanto a votação estiver aberta.
        // Cada aparelho lê só o próprio voto; a contagem é vista pelos administradores.
        match /votos/{uid} {
          allow read: if isMember(gid) || (signed() && request.auth.uid == uid);
          allow create, update: if signed() && request.auth.uid == uid
            && grpAtivo(gid)
            && get(/databases/$(database)/documents/grupos/$(gid)/votacoes/$(vid)).data.open == true
            && request.resource.data.keys().hasOnly(['pid', 'v', 't'])
            && idValido(request.resource.data.get('pid', ''))
            && request.resource.data.get('v', {}) is map && request.resource.data.get('v', {}).size() <= 30;
          allow delete: if isMember(gid);
        }
      }
    }
  }
}
